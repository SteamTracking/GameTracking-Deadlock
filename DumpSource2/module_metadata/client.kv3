						{
							m_eType = "choices"
							m_Items = 
							[
								{
									m_iValue = 0
									m_Value = "Normal"
									m_FriendlyName = "Normal"
									m_bDefault = false
									m_bCustom = false
									m_Description = "Damage reduces the part's health pool and the owner entity equally."
								},
								{
									m_iValue = 0
									m_Value = "Absorb"
									m_FriendlyName = "Absorb"
									m_bDefault = false
									m_bCustom = false
									m_Description = "Damage reduces the part's health pool but not the owner entity until destroyed. (i.e., limited armour)"
								},
								{
									m_iValue = 0
									m_Value = "InvincibleAbsorb"
									m_FriendlyName = "InvincibleAbsorb"
									m_bDefault = false
									m_bCustom = false
									m_Description = "Damage is completely ignored - i.e., this part ignores the health value and does not send damage to the owner entity."
								},
								{
									m_iValue = 0
									m_Value = "InvinciblePassthrough"
									m_FriendlyName = "InvinciblePassthrough"
									m_bDefault = false
									m_bCustom = false
									m_Description = "Damage reduces the owner entity but not the part (health is ignored): part can only be destroyed by gibbing or procedurally."
								},
