		0 : "eNone"
		1 : "ePreserveUpAxis"
	]
	goal_direction_type(intchoices) : "goal_direction_type" : : "" = // FIELD_INT32 m_nGoalDirection (PointOrientGoalDirectionType_t)
	[
		0 : "eAbsOrigin"
		1 : "eCenter"
		2 : "eHead"
		3 : "eForward"
		4 : "eEyesForward"
	]
	max_turn_rate(float) // FIELD_FLOAT32 m_flMaxTurnRate
	input SetActive(boolean) // PVAL_BOOL param
	input SetTarget(string) // PVAL_STRING param
]

// CPointTemplate, ECF_PRECACHE_NETWORKED_ENTITY_ON_CLIENT
@PointClass base(CLogicalEntity) = point_template
[
	worldName(string) // FIELD_STRING m_iszWorldName
	entityLumpName(string) // FIELD_STRING m_iszSource2EntityLumpName
	entityFilterName(string) // FIELD_STRING m_iszEntityFilterName
	asynchronous(boolean) // FIELD_BOOLEAN m_bAsynchronouslySpawnEntities
	timeoutInterval(float) // FIELD_FLOAT32 m_flTimeoutInterval
	spawnGroupType(intchoices) : "spawnGroupType" : : "" = // FIELD_INT32 m_ownerSpawnGroupType (PointTemplateOwnerSpawnGroupType_t)
	[
		0 : "INSERT_INTO_POINT_TEMPLATE_SPAWN_GROUP"
		1 : "INSERT_INTO_CURRENTLY_ACTIVE_SPAWN_GROUP"
		2 : "INSERT_INTO_NEWLY_CREATED_SPAWN_GROUP"
	]
	createClientOnlyEntities(intchoices) : "createClientOnlyEntities" : : "" = // FIELD_INT32 m_clientOnlyEntityBehavior (PointTemplateClientOnlyEntityBehavior_t)
	[
		0 : "CREATE_FOR_CURRENTLY_CONNECTED_CLIENTS_ONLY"
		1 : "CREATE_FOR_CLIENTS_WHO_CONNECT_LATER"
	]
	input DeleteCreatedSpawnGroups(void) : "Deletes all spawn groups created by the template. Only works if you use asynchronous spawn and INSERT_INTO_NEWLY_CREATED_SPAWN_GROUP." // Pulse node
	input ForceSpawn(void) : "Spawn an instance of the template at the original position." // Pulse node
	input ForceSpawnAtLocation(api) // PVAL_EHANDLE pLocationEntity, PVAL_STRING pSpawnedEntityName, returns PVAL_EHANDLE retval, Pulse node: Tells the point_template entity to ForceSpawn and return the first entity that matches the name (wildcard)
	input ForceSpawnReturnEntities(target_destination) : "Tells the point_template entity to ForceSpawn and return the all the entities spawned" // PVAL_EHANDLE pLocationEntity, returns PVAL_ARRAY:PVAL_EHANDLE retval, Pulse node
	input GetSpawnedEntities(void) : "Get the list of the most recent spawned entities." // returns PVAL_ARRAY:PVAL_EHANDLE retval, Pulse node
	output OnEntitySpawned(string) : "Fired after spawning an instance of this template." // PVAL_ARRAY:PVAL_EHANDLE param
]

