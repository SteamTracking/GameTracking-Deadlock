// C_BaseTrigger
@PointClass base(C_BaseToggle) = trigger
[
	StartDisabled(boolean) // FIELD_BOOLEAN m_bDisabled
	filtername(string) // FIELD_STRING m_iFilterName
	okifnomodel(boolean) // FIELD_BOOLEAN
	radius(float) // FIELD_FLOAT32
	input Disable(void)
	input Enable(void)
	input EndTouch(void)
	input FindEntitiesInTrigger(api) // PVAL_STRING entityType, PVAL_ENTITY_NAME optionalEntityName, returns PVAL_ARRAY:PVAL_EHANDLE retval, Pulse node: Return the current entities touching the trigger, matching the optional criteria.<br><br>This node can appear in Observable contexts.
	input IsTouching(target_destination) : "Is the other entity touching the trigger?<br><br>This node can appear in Observable contexts." // PVAL_EHANDLE pOtherEntity, returns PVAL_BOOL retval, Pulse node
	input IsTouchingAny(void) : "Is there any entity touching the trigger?<br><br>This node can appear in Observable contexts." // returns PVAL_BOOL retval, Pulse node
	input StartTouch(void)
	input Toggle(void)
	input TouchTest(void)
	output OnEndTouch(void)
	output OnEndTouchAll(void)
	output OnNotTouching(void)
	output OnStartTouch(void)
	output OnStartTouchAll(void)
	output OnTouching(void)
	output OnTouchingChanged(void)
	output OnTouchingEachEntity(void)
]

