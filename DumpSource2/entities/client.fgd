		0 : "ANIM_LOOP_MODE_NOT_LOOPING"
		1 : "ANIM_LOOP_MODE_LOOPING"
		2 : "ANIM_LOOP_MODE_USE_SEQUENCE_SETTINGS"
		3 : "ANIM_LOOP_MODE_COUNT"
	]
	glowstate(integer) // FIELD_INT32 m_iInitialGlowState
	glowrange(integer) // FIELD_INT32 m_nGlowRange
	glowrangemin(integer) // FIELD_INT32 m_nGlowRangeMin
	glowcolor(color255) // FIELD_COLOR32 m_glowColor
	glowteam(integer) // FIELD_INT32 m_nGlowTeam
	forcenpcexclude(boolean) // FIELD_BOOLEAN m_bForceNpcExclude
	create_surface_graph(boolean) // FIELD_BOOLEAN m_bCreateMovableSurfaceGraph
	StartingAnim(string) // FIELD_STRING
	StartingAnimationLoopMode(string) // FIELD_STRING
	health(integer) // FIELD_INT32
	HoldAnimation(boolean) // FIELD_BOOLEAN
	input Disable(void)
	input DisableCollision(void)
	input Enable(void)
	input EnableCollision(void)
	input SetAnimation(string) // PVAL_STRING param
	input SetAnimationLooping(string) // PVAL_STRING param
	input SetAnimationNoReset(string) // PVAL_STRING param
	input SetAnimationNoResetLooping(string) // PVAL_STRING param
	input SetAnimationNoResetNotLooping(string) // PVAL_STRING param
	input SetAnimationNotLooping(string) // PVAL_STRING param
	input SetDefaultAnimation(string) // PVAL_STRING param
	input SetDefaultAnimationLooping(string) // PVAL_STRING param
	input SetDefaultAnimationNotLooping(string) // PVAL_STRING param
	input SetGlowOverride(vector) // PVAL_VEC3 param
	input SetGlowRange(integer) // PVAL_INT param
	input SetIdleAnimationLooping(string) // PVAL_STRING param
	input SetIdleAnimationNotLooping(string) // PVAL_STRING param
	input SetPlaybackRate(float) // PVAL_FLOAT param
	input StartGlowing(void)
	input StopGlowing(void)
	input TurnOff(void)
	input TurnOn(void)
	output OnAnimationBegun(void)
	output OnAnimationDone(void)
	output OnAnimationLoopCycleDone(void)
	output OnAnimationReachedEnd(void)
	output OnAnimationReachedStart(void)
	output OnScriptFireEvent01(void) : "Fired when the animation hits the matching AE_SCRIPT_FIRE_EVENT_XX anim event."
	output OnScriptFireEvent02(void) : "Fired when the animation hits the matching AE_SCRIPT_FIRE_EVENT_XX anim event."
	output OnScriptFireEvent03(void) : "Fired when the animation hits the matching AE_SCRIPT_FIRE_EVENT_XX anim event."
	output OnScriptFireEvent04(void) : "Fired when the animation hits the matching AE_SCRIPT_FIRE_EVENT_XX anim event."
	output OnScriptFireEvent05(void) : "Fired when the animation hits the matching AE_SCRIPT_FIRE_EVENT_XX anim event."
]

