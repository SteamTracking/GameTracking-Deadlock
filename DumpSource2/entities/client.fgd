// CCitadelZipLineNode
@PointClass base(basemodelentity) = zip_line_node
[
	lane_number(integer) // FIELD_INT16 m_iPrimaryLane
	node_index(integer) // FIELD_INT16 m_iNodeIndex
	corner_node(boolean) // FIELD_BOOLEAN m_bCornerNode
	capturable(boolean) // FIELD_BOOLEAN m_bCapturable
	rope_radius(float) // FIELD_FLOAT32 m_flRopeRadius
	disable_zipping_to(boolean) // FIELD_BOOLEAN m_bDisableZippingToByPlayers
	tangent_in(vector) // FIELD_DIRECTION_VECTOR_WORLDSPACE m_vTangentIn
	tangent_out(vector) // FIELD_DIRECTION_VECTOR_WORLDSPACE m_vTangentOut
	cumulative_distance(float) // FIELD_FLOAT32 m_flCumulativeDistance
	speed_multiplier_to_base_bonus(float) // FIELD_FLOAT32 m_flSpeedMultiplierToBaseBonus
	speed_multiplier_from_base_bonus(float) // FIELD_FLOAT32 m_flSpeedMultiplierFromBaseBonus
]

