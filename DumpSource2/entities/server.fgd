	input SetFollowEntityForward(target_destination) : "Set the name of an entity that the mover should follow forward along the path -- it will try to maintain a given distance from this entity along the path." // PVAL_EHANDLE hEnt, Pulse node
	input SetFollowEntityReverse(target_destination) : "Set the name of an entity that the mover should follow reverse along the path -- it will try to maintain a given distance from this entity along the path." // PVAL_EHANDLE hEnt, Pulse node
	input SetFollowMinimumSpeed(float) // PVAL_FLOAT param
	input SetFollowMoverConstraintType(integer) // PVAL_INT param
	input SetFollowMoverEntity(target_destination) : "Sets the name of another mover the entity should follow." // PVAL_EHANDLE:func_mover pMover, Pulse node
