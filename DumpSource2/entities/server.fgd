	input Extinguish(void)
	input GetIntactDestructibleHitGroups(void) : "Returns the destructible hitgroups that are still intact." // returns PVAL_ARRAY:PVAL_ENUM:HitGroup_t retval, Pulse node
	input GetJointLimitAngles(string) : "Returns the joint limit angles." // PVAL_STRING pJointName, returns PVAL_BOOL retval, PVAL_FLOAT MinAngle, PVAL_FLOAT MaxAngle, Pulse node
	input GetRenderAlpha(void) : "Get object render alpha (0-255)" // returns PVAL_INT retval, Pulse node
	input GetRenderColor(void) : "Get object render color (Alpha is ignored)" // returns PVAL_COLOR_RGB retval, Pulse node
	input Ignite(void)
	input IgniteHitboxFireScale(float) // PVAL_FLOAT param
	input IgniteLifetime(float) // PVAL_FLOAT param
	input IgniteNumHitboxFires(integer) // PVAL_INT param
	input IsDestructibleHitGroupIntact(string) : "True/False if hitgroup is intact.  If hitgroup is not a destructible hitgroup you'll get a warning and it'll return false." // PVAL_ENUM:HitGroup_t nHitGroup, returns PVAL_BOOL retval, Pulse node
	input SetBodyGroupValue(api) // PVAL_STRING pBodyGroupName, PVAL_INT iValue, Pulse node: Change the active choice for the named bodygroup to the specified value
	input SetJointLimitAngles(api) // PVAL_STRING pJointName, PVAL_FLOAT flMinAngle, PVAL_FLOAT flMaxAngle, Pulse node: Sets the joint limit angles. Only valid for prismatic and revolute joints.
	input SetJointLimitEnabled(api) // PVAL_STRING pJointName, PVAL_BOOL bEnabled, Pulse node: Enables/disables the joint limit. Only valid for prismatic and revolute joints.
	input SetMaterialGroup(string) : "Change the active materialgroup" // PVAL_STRING pName, Pulse node
	input SetModel(string) : "Change the current model" // PVAL_RESOURCE:vmdl hModel, Pulse node
	input SetRenderAlpha(integer) : "Alpha 0-255" // PVAL_INT nAlpha, Pulse node
	input SetRenderAttribute(string) // PVAL_STRING pValue
	input SetRenderAttribute4Floats(api) // PVAL_STRING pAttributeName, PVAL_FLOAT flX, PVAL_FLOAT flY, PVAL_FLOAT flZ, PVAL_FLOAT flW, Pulse node: Set the specified render attribute value
	input SetRenderAttributeFloat(api) // PVAL_STRING pAttributeName, PVAL_FLOAT flValue, Pulse node: Set the specified render attribute value
	input SetRenderAttributeVector(api) // PVAL_STRING pAttributeName, PVAL_VEC3 vValue, Pulse node: Set the specified render attribute value
	input SetRenderColor(color255) : "Set object render color (Alpha is ignored)" // PVAL_COLOR_RGB cColor, Pulse node
	input Skin(integer) // PVAL_INT param
	input fademaxdist(float) // PVAL_FLOAT param
	input fademindist(float) // PVAL_FLOAT param
	output OnDestructibleHitGroupDamageLevelChanged(api) // PVAL_ENUM:HitGroup_t nHitGroup, PVAL_INT nDamageLevel, PVAL_INT nDamageLevelsRemaining, PVAL_INT nPrevDamageLevel: Called when the damage level of destructible part for a particular hit group has been changed.
	output OnIgnite(void)
]

// CBaseAnimGraph
@PointClass base(basemodelentity) = baseanimgraph
[
	// component CBodyComponent: CBodyComponentBaseAnimGraph
		// m_animationController (CBaseAnimGraphController)
			playbackrate(float) // FIELD_NETWORK_QUANTIZED_FLOAT m_flPlaybackRate
			animgraph2_identifier(string) // FIELD_GLOBALSYMBOL m_sAnimGraph2Identifier
	initially_populate_interp_history(boolean) // FIELD_BOOLEAN m_bInitiallyPopulateInterpHistory
	input ClearTargetIdentifierOverride(void)
	input GetLayerCycle(integer) : "Returns the cycle of an animation playing on this layer<br><br>This node can appear in Observable contexts." // PVAL_INT iLayer, returns PVAL_FLOAT retval, Pulse node
	input IsAnimEventActive(string) : "Is the specified AG2 event active?<br><br>This node can appear in Observable contexts." // PVAL_ENUM:GameAnimEventIndex_t nAnimEvent, returns PVAL_BOOL retval, Pulse node
	input IsExternalChoreoGraphActive(void) : "Is there an external choreo animgraph applied to this entity<br><br>This node can appear in Observable contexts." // returns PVAL_BOOL retval, Pulse node
	input PlaySequence(string) : "Play the specified animation sequence on a NON-ANIMGRAPH entity" // PVAL_STRING pSequenceName, Pulse node
	input SetBodygroup(string) // PVAL_STRING param
	input SetPlaybackRate(float) // PVAL_FLOAT param
	input SetTargetIdentifierOverride(string) // PVAL_STRING param
	output OnLayerCycleUpdated(float) // PVAL_FLOAT param
	output m_OnExternalChoreoGraphChanged(void)
]

// CBaseCombatCharacter
@BaseClass base(baseanimgraph) = base_combat_character
[
	Relationship(string) // FIELD_STRING m_strRelationships
	physdamagescale(float) // FIELD_FLOAT32 m_impactEnergyScale
	input SetRelationship(string) // PVAL_STRING param
	input physdamagescale(float) // PVAL_FLOAT param
]

// CBasePlayerPawn, ECF_SPAWN_GROUP_HANDLE_INVALID
@PointClass base(base_combat_character) = baseplayerpawn
[
	// m_skybox3d (sky3dparams_t)
		scale(integer) // FIELD_INT16 scale
		clip_3D_skybox_near_to_world_far(boolean) // FIELD_BOOLEAN bClip3DSkyBoxNearToWorldFar
		clip_3D_skybox_near_to_world_far_offset(float) // FIELD_FLOAT32 flClip3DSkyBoxNearToWorldFarOffset
		// fog (fogparams_t)
			fogdir(vector) // FIELD_DIRECTION_VECTOR_WORLDSPACE dirPrimary
			fogcolor(color255) // FIELD_COLOR32 colorPrimary
			fogcolor2(color255) // FIELD_COLOR32 colorSecondary
			fogstart(float) // FIELD_FLOAT32 start
			fogend(float) // FIELD_FLOAT32 end
			farz(float) // FIELD_FLOAT32 farz
			fogmaxdensity(float) // FIELD_FLOAT32 maxdensity
			fogexponent(float) // FIELD_FLOAT32 exponent
			HDRColorScale(float) // FIELD_FLOAT32 HDRColorScale
			foglerptime(float) // FIELD_FLOAT32 duration
			fogenable(boolean) // FIELD_BOOLEAN enable
			fogblend(boolean) // FIELD_BOOLEAN blend
			blendtobackground(float) // FIELD_FLOAT32 blendtobackground
			scattering(float) // FIELD_FLOAT32 scattering
			locallightscale(float) // FIELD_FLOAT32 locallightscale
	controller(target_destination) // FIELD_EHANDLE
	input SetFogController(string) // PVAL_STRING param
	input SetHUDVisibility(boolean) // PVAL_BOOL param
	input SetHealth(integer) // PVAL_INT param
]

