// CCitadelZipLineNode
@PointClass base(basemodelentity) = zip_line_node
[
	lane_number(integer) // FIELD_INT16 m_iPrimaryLane
	node_index(integer) // FIELD_INT16 m_iNodeIndex
	corner_node(boolean) // FIELD_BOOLEAN m_bCornerNode
	capturable(boolean) // FIELD_BOOLEAN m_bCapturable
	rope_radius(float) // FIELD_FLOAT32 m_flRopeRadius
	disable_zipping_to(boolean) // FIELD_BOOLEAN m_bDisableZippingToByPlayers
	tangent_in(vector) // FIELD_DIRECTION_VECTOR_WORLDSPACE m_vTangentIn
	tangent_out(vector) // FIELD_DIRECTION_VECTOR_WORLDSPACE m_vTangentOut
	cumulative_distance(float) // FIELD_FLOAT32 m_flCumulativeDistance
	speed_multiplier_to_base_bonus(float) // FIELD_FLOAT32 m_flSpeedMultiplierToBaseBonus
	speed_multiplier_from_base_bonus(float) // FIELD_FLOAT32 m_flSpeedMultiplierFromBaseBonus
	guard_boss_name(string) // FIELD_STRING m_strGuardBossName
	secondary_guard_boss_name(string) // FIELD_STRING m_strGuardBossName2
	tertiary_guard_boss_name(string) // FIELD_STRING m_strGuardBossName3
]

// Datamaps that no entity class has, like modifiers and structs that only code fills

@BaseClass = CAI_InterestTarget
[
	target(target_destination) // FIELD_EHANDLE m_hTarget
	target_position(vector) // FIELD_POSITION_VECTOR m_vPosition
	target_direction(vector) // FIELD_DIRECTION_VECTOR_WORLDSPACE m_vDirection
	discard_outside_viewcone(boolean) // FIELD_BOOLEAN m_bDiscardOutsideViewcone
	look_at_mode(intchoices) : "look_at_mode" : : "" = // FIELD_INT32 m_nLookAtMode (ChoreoLookAtMode_t)
	[
		-1 : "eInvalid"
		0 : "eChest"
		1 : "eHead"
		2 : "eEyesOnly"
	]
	look_at_speed(intchoices) : "look_at_speed" : : "" = // FIELD_INT32 m_nLookAtSpeed (ChoreoLookAtSpeed_t)
	[
		-1 : "eInvalid"
		0 : "eSlow"
		1 : "eMedium"
		2 : "eFast"
	]
]

@BaseClass = CBaseModifier
[
	stack_count(integer) // FIELD_INT16 m_iStackCount
	max_stack_count(integer) // FIELD_INT16 m_iMaxStackCount
	attributes(integer) // FIELD_UINT8 m_iAttributes
]

@BaseClass base(CBaseModifier) = CCitadelModifier
[
	effectiveness(float) // FIELD_FLOAT32 m_flEffectiveness
]

@BaseClass base(CCitadelModifier) = CBaseModifierAura
[
	radius(float) // FIELD_FLOAT32 m_flOverrideRadius
]

@BaseClass base(CCitadelModifier) = CGameModifier_BodyGroupChoice
[
	body_group_choice(integer) // FIELD_INT32 m_nBodyGroupChoice
	body_group_name(string) // FIELD_UTLSTRINGTOKEN m_nBodyGroupName
]

@BaseClass base(CCitadelModifier) = CGameModifier_OverrideTargetIdentifier
[
	identifier(string) // FIELD_GLOBALSYMBOL m_sTargetIdentifier
	entity(target_destination) // FIELD_EHANDLE m_hTarget
	attachment_name(string) // FIELD_GLOBALSYMBOL m_sAttachmentName
	origin_type(intchoices) : "origin_type" : : "" = // FIELD_INT32 m_nOriginType (EntityAttachmentType_t)
	[
		0 : "eAbsOrigin"
		1 : "eCenter"
		2 : "eEyes"
		3 : "eAttachment"
		4 : "eLocalOffset"
	]
	local_offset(string) // FIELD_VOID
]

@BaseClass base(CCitadelModifier) = CGameModifier_PlayEffectOnDeath
[
	effect_name(string) // FIELD_UTLSTRING m_sEffect
]

@BaseClass base(CCitadelModifier) = CGameModifier_SetMoveType
[
	MoveType(intchoices) : "MoveType" : : "" = // FIELD_UINT8 m_nMoveType (MoveType_t)
	[
		0 : "MOVETYPE_NONE"
		1 : "MOVETYPE_OBSOLETE"
		2 : "MOVETYPE_WALK"
		3 : "MOVETYPE_FLY"
		4 : "MOVETYPE_FLYGRAVITY"
		5 : "MOVETYPE_VPHYSICS"
		6 : "MOVETYPE_PUSH"
		7 : "MOVETYPE_NOCLIP"
		8 : "MOVETYPE_OBSERVER"
		9 : "MOVETYPE_STEP"
		10 : "MOVETYPE_SYNC"
		11 : "MOVETYPE_CUSTOM"
		12 : "MOVETYPE_LAST"
		12 : "MOVETYPE_INVALID"
		5 : "MOVETYPE_MAX_BITS"
	]
]

@BaseClass base(CCitadelModifier) = CGameModifier_VehicleTopSpeedScale
[
	top_speed_scale(float) // FIELD_FLOAT32 m_flTopSpeedScale
]

@BaseClass = CNetworkedSequenceOperation
[
	cycle(float) // FIELD_FLOAT32 m_flCycle
	sequenceName(string) // FIELD_UTLSTRING
	sequence(integer) // FIELD_INT32
]

@BaseClass = PathAccompanyNode_t
[
	gaitOverride(string) // FIELD_STRING
	customGaitOverride(string) // FIELD_STRING
