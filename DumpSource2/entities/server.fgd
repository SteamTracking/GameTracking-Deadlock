// CAI_Hint
@PointClass base(CServerOnlyEntity) = ai_hint
[
	// m_NodeData (HintNodeData)
		hinttype(integer) // FIELD_INT16 nHintType
		Group(string) // FIELD_STRING strGroup
		StartHintDisabled(integer) // FIELD_INT32 iDisabled
		generictype(string) // FIELD_STRING iszGenericType
		IgnoreFacing(intchoices) : "IgnoreFacing" : : "" = // FIELD_INT32 fIgnoreFacing (HintIgnoreFacing_t)
		[
			0 : "HIF_NO"
			1 : "HIF_YES"
			2 : "HIF_DEFAULT"
		]
		MinimumState(intchoices) : "MinimumState" : : "" = // FIELD_INT32 minState (NPC_STATE)
		[
			-1 : "NPC_STATE_INVALID"
			0 : "NPC_STATE_INIT"
			1 : "NPC_STATE_IDLE"
			2 : "NPC_STATE_ALERT"
			3 : "NPC_STATE_COMBAT"
			4 : "NPC_STATE_SCRIPT"
			5 : "NPC_STATE_DEAD"
			6 : "NPC_STATE_INERT"
			7 : "NPC_STATE_SYNCHRONIZED_SECONDARY"
			8 : "NUM_NPC_STATES"
		]
		MaximumState(intchoices) : "MaximumState" : : "" = // FIELD_INT32 maxState (NPC_STATE)
		[
			-1 : "NPC_STATE_INVALID"
			0 : "NPC_STATE_INIT"
			1 : "NPC_STATE_IDLE"
			2 : "NPC_STATE_ALERT"
			3 : "NPC_STATE_COMBAT"
			4 : "NPC_STATE_SCRIPT"
			5 : "NPC_STATE_DEAD"
			6 : "NPC_STATE_INERT"
			7 : "NPC_STATE_SYNCHRONIZED_SECONDARY"
			8 : "NUM_NPC_STATES"
		]
		priority(intchoices) : "priority" : : "" = // FIELD_INT32 ePriority (HintPriority_t)
		[
			0 : "HINT_PRIORITY_LOW"
			1 : "HINT_PRIORITY_MEDIUM"
			2 : "HINT_PRIORITY_HIGH"
			3 : "HINT_PRIORITY_CRITICAL"
		]
		radius(integer) // FIELD_INT32 nRadius
	nodeFOV(float) // FIELD_FLOAT32 m_nodeFOV
	animgraph_entry_action(string) // FIELD_STRING m_iszAnimgraphEntryAction
	animgraph_exit_action(string) // FIELD_STRING m_iszAnimgraphExitAction
	animgraph_entry_cmd(string) // FIELD_STRING m_iszAnimgraphEntryCmd
	animgraph_exit_cmd(string) // FIELD_STRING m_iszAnimgraphExitCmd
	animgraph_navlink_target(string) // FIELD_STRING m_iszNavlinkTargetName
	remove_on_unreserved(boolean) // FIELD_BOOLEAN m_bRemoveOnUnreserved
	interaction_distance(float) // FIELD_FLOAT32 m_flInteractionDistance
	cooldown(float) // FIELD_FLOAT32 m_flCooldown
	npc_follows_entity(string) // FIELD_STRING m_iszNPCFollowsEntity
	npc_snap_to_hint_distance(float) // FIELD_FLOAT32 m_flNPCSnapToHintDistance
	input DisableHint(void)
	input EnableHint(void)
	input ToggleHint(void)
	output OnNPCStartedUsing(target_destination) // PVAL_EHANDLE param
	output OnNPCStoppedUsing(target_destination) // PVAL_EHANDLE param
]

