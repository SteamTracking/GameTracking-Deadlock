		<include src="s2r://panorama/styles/popups/popups_shared.vcss" />
		<include src="s2r://panorama/styles/popups/popup_settings.vcss" />
		<include src="s2r://panorama/styles/popups/citadel_popup_keybind.vcss" />
	</styles>
	<PopupKeybind class="PopupPanel Hidden" popupbackground="dim" oncancel="UIPopupButtonClicked()">
		<Panel class="PopupBackgroundShadow" />
		<Panel class="PopupBackground" />
		<Panel class="PopupContent">
			<Label class="PopupTitle" text="#citadel_keybind_popup_title" />
			<Panel id="BindingNameContainer">
				<Image id="HeroIcon" />
				<Label id="BindingCommandName" text="{s:command}" />
			</Panel>
			<Label id="RestrictedBindLabel" text="{s:bind_restriction_text}" html="true" />
			<Panel id="BindingsContainer">
				<Panel id="PrimaryBindingContainer" class="Binding">
					<Panel class="BindingRow LeftRightFlow">
						<Panel id="PrimaryBinding" class="InputField" onactivate="CitadelCaptureBinding(0)">
							<Panel class="Background" />
							<Panel class="Border" />
							<CitadelKeyboardGlyph id="PrimaryDisplayGlyph" />
							<Panel class="KeybinderCursor" />
							<Panel id="InvalidInput">
								<Image />
							</Panel>
						</Panel>
						<Panel class="ButtonWrapper">
							<CitadelButton id="ClearBinding1" class="Medium" imagesrc="s2r://panorama/images/icons/delete_trash.vsvg" onactivate="CitadelClearSingleKeybinding(0)" onmouseover="UIShowTextTooltipStyled( #citadel_settings_clear_keybind_tooltip , SettingsMenuTooltip)" onmouseout="UIHideTextTooltip()" />
						</Panel>
					</Panel>
					<Panel id="DupeBindingContainer1">
						<Label id="BindingConflictWarning" class="AlignHorizontalCenter" text="#Citadel_KeybindConflict" />
						<Panel class="LeftRightFlow AlignHorizontalCenter">
							<CitadelKeyboardGlyph id="PrimaryDupeDisplayGlyph" />
							<Label id="ExistingBinding" text="{s:existing_binding_primary}" html="true" />
						</Panel>
					</Panel>
				</Panel>
				<Panel class="ColGap" />
				<Panel id="AddSecondaryBindingPanel" onactivate="CitadelShowSecondaryBinding()">
					<Label id="ExpandSymbol" class="ExpandSecondary" text="+" />
				</Panel>
				<Panel id="SecondaryBindingContainer" class="Binding">
					<Panel class="BindingRow LeftRightFlow">
						<Panel id="SecondaryBinding" class="InputField" onactivate="CitadelCaptureBinding(1)">
							<Panel class="Background" />
							<Panel class="Border" />
							<CitadelKeyboardGlyph id="SecondaryDisplayGlyph" />
							<Panel class="KeybinderCursor" />
							<Panel id="InvalidInput">
								<Image />
							</Panel>
						</Panel>
						<Panel class="ButtonWrapper">
							<CitadelButton id="ClearBinding2" class="Medium" imagesrc="s2r://panorama/images/icons/delete_trash.vsvg" onactivate="CitadelClearSingleKeybinding(1)" onmouseover="UIShowTextTooltipStyled( #citadel_settings_clear_keybind_tooltip , SettingsMenuTooltip)" onmouseout="UIHideTextTooltip()" />
						</Panel>
					</Panel>
					<Panel id="DupeBindingContainer2">
						<Label id="BindingConflictWarning" class="AlignHorizontalCenter" text="#Citadel_KeybindConflict" />
						<Panel class="LeftRightFlow AlignHorizontalCenter">
							<CitadelKeyboardGlyph id="SecondaryDupeDisplayGlyph" />
							<Label id="ExistingBinding" text="{s:existing_binding_secondary}" html="true" />
						</Panel>
					</Panel>
				</Panel>
			</Panel>
			<Panel class="HR1px" />
			<Panel class="Buttons">
				<CitadelButton id="ResetBinding" class="Medium Fill" imagesrc="s2r://panorama/images/icons/reset.vsvg" onactivate="CitadelResetKeybinding()" onmouseover="UIShowTextTooltipStyled( #citadel_settings_reset_keybind_tooltip , SettingsMenuTooltip)" onmouseout="UIHideTextTooltip()" />
				<CitadelButton id="CancelBinding" class="Medium Fill" text="#citadel_keybind_popup_cancel" onactivate="UIPopupButtonClicked()" />
				<CitadelButton id="ConfirmBinding" class="Medium Fill CTA" text="{s:confirm_button_text}" onactivate="CitadelConfirmKeyBind()" />
