			},
			{
				name = "opvar_get_viewing_pawn_position"
				operator = "opvar_get_float3"
				input_execute = "1.0"
				input_stack_name = "citadel_relevance_opvars"
				input_operator_name = "opvars"
				input_field_name = "viewing_entity_position"
			},
			{
				name = "obb_info"
				operator = "obb_info"
				input_obb_origin = "@public.obb_origin"
				input_obb_angles = "@public.obb_angles"
				input_obb_bounds_min = "@public.obb_mins"
				input_obb_bounds_max = "@public.obb_maxs"
				input_position = "@opvar_get_viewing_pawn_position.output"
			},
			{
				name = "globals"
				operator = "get_system_globals"
				input_listener_index = "0"
			},
			{
				name = "source_info"
				operator = "game_get_source_info"
			},
			{
				name = "get_viewing_entity_index"
				operator = "opvar_get_float"
				input_execute = "1.0"
				input_stack_name = "citadel_relevance_opvars"
				input_operator_name = "opvars"
				input_field_name = "viewing_entity_index"
			},
			{
				name = "position_filter"
				operator = "math_filter_float"
				input = "@obb_info.output_point_in_obb"
				input_max_velocity = "5.0"
			},
			{
				name = "listener_position"
				operator = "math_float3"
				apply = "add"
				input1 = "@globals.output_listener_position"
				input2 = "@globals.output_listener_forward"
			},
			{
				name = "lerp_position"
				operator = "math_lerp_float3"
				input_factor = "@position_filter.output"
				input_position_a = "@obb_info.output_closest_point"
				input_position_b = "@listener_position.output"
			},
			{
				name = "get_listener_height"
				operator = "util_elements_float3"
				input_execute = "@interior_filter.output"
				execute_once = "false"
				input = "@opvar_get_viewing_pawn_position.output"
			},
			{
				name = "remap_listener_height"
				operator = "math_remap_float"
				input = "@get_listener_height.output_2"
				input_min = "@public.rooftop_min_height"
				input_max = "@public.rooftop_max_height"
				input_map_min = "0.000000"
				input_map_max = "1.000000"
				clamp_range = "true"
			},
			{
				name = "rooftop_filter"
				operator = "math_filter_float"
				input = "@remap_listener_height.output"
				input_max_velocity = "@public.height_filter_speed"
			},
			{
				name = "remap_rooftop_exterior_volume_offset"
				operator = "math_curve_2d"
				input_execute = "1.0"
				input = "@rooftop_filter.output"
				public_field_name = "public.exterior_high_alt_vol_offset_curve_db"
			},
			{
				name = "remap_rooftop_xfade_layer_volume"
				operator = "math_curve_2d"
				input_execute = "1.0"
				input = "@rooftop_filter.output"
				public_field_name = "public.rooftop_layer_high_alt_vol_offset_curve_db"
			},
			{
				name = "math_add_rooftop_xfade_layer_vol_offset"
				operator = "math_float"
				apply = "add"
				input_execute = "1.0"
				input1 = "@remap_rooftop_xfade_layer_volume.output"
				input2 = "@public.rooftop_layer_vol_offset_db"
			},
			{
				name = "send_voicegraph_rooftop_amount"
				operator = "vmix_voicegraph_input"
				input_execute = "1.0"
				execute_once = "false"
				input_name = "rooftop_filter"
				input = "@rooftop_filter.output"
			},
			{
				name = "import_steamaudio_dimension_probes"
				operator = "sos_import_stack"
				import_stack = "citadel_steamaudio_dimension_probes"
				operator_variables = 
				{
					input_steamaudio_dimension_probes_entity_index = 
					{
						data_type = "float"
						value = "@get_viewing_entity_index.output"
					}
				}
			},
			{
				name = "normalize_room_size_to_enclosure"
				operator = "math_float"
				apply = "div"
				input1 = "@import_steamaudio_dimension_probes::output.dimension_size"
				input2 = "2500"
			},
			{
				name = "interior_filter"
				operator = "math_filter_float"
				input = "@normalize_room_size_to_enclosure.output"
				input_max_velocity = "1.0"
			},
			{
				name = "switch_enable_interior_filtering"
				operator = "ctrl_switch_float"
				input_switch = "@public.enable_interior_lpf"
				input1 = "1.0"
				input2 = "@interior_filter.output"
			},
			{
				name = "remap_interior_volume_offset"
				operator = "math_curve_2d"
				input_execute = "1.0"
				input = "@interior_filter.output"
				public_field_name = "public.interior_vol_offset_db"
			},
			{
				name = "math_add_vol_offsets_db"
				operator = "math_float"
				input_execute = "1.0"
				apply = "add"
				input1 = "@remap_interior_volume_offset.output"
				input2 = "@remap_rooftop_exterior_volume_offset.output"
			},
			{
				name = "math_volume_offsets_db_to_gain"
				input_execute = "1.0"
				operator = "math_db_to_gain"
				input = "@math_add_vol_offsets_db.output"
			},
			{
				name = "send_voicegraph_interior_amount"
				operator = "vmix_voicegraph_input"
				input_execute = "1.0"
				input_name = "interior_lpf"
				input = "@switch_enable_interior_filtering.output"
			},
			{
				name = "send_voicegraph_volume_offsets"
				operator = "vmix_voicegraph_input"
				input_execute = "1.0"
				input_name = "rooftop_and_interior_volume_offset"
				input = "@math_volume_offsets_db_to_gain.output"
			},
			{
