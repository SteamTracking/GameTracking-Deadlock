{
	citadel_perspective_group_volume_mute = 
	{
		operators = 
		[
			{
				name = "_builtins"
				operator = "sos_builtins"
				_voicegraph = "citadel_hrtf_basic"
			},
			{
				name = "public"
				operator = "util_null"
				operator_variables = 
				{
					citadel_perspective_default = 
					{
						data_type = "public_opvar"
						value = "citadel_perspective_default"
					}
					group_pause = 
					{
						data_type = "float"
						value = "1.000000"
						_system_properties = 
						{
							display_group = "locked"
							property_group = "citadel_perspective_group_volume_mute - Volume"
						}
					}
					group_vol_filter_rate = 
					{
						data_type = "float"
						value = "1.0"
						_system_properties = 
						{
							display_group = "Normal"
							property_group = "citadel_perspective_group_volume_mute - Volume"
							property_help = "The speed with which volume changes are made."
						}
					}
				}
			},
			{
				name = "globals"
				operator = "get_system_globals"
				input_execute = "1"
				input_listener_index = "0"
			},
			{
				name = "source_info"
				operator = "game_get_source_info"
			},
			{
				name = "test_from_player_index"
				operator = "ctrl_switch_float"
				input_switch = "@public.position_force_from_player"
				input2 = "-1"
				input1 = "@source_info.output_entity_index"
			},
			{
				name = "get_entity_info"
				input_execute = "1"
				execute_once = "@public.position_force_static"
				operator = "game_entity_info"
				input_entity_index = "@test_from_player_index.output"
				input_default_world_position = "@public.position"
				input_default_local_position = "@globals.output_listener_front"
				use_world_position = "@public.position_force_from_input"
				attachment = "@public.attachment"
			},
			{
				name = "distance_to_source"
				operator = "calc_distance"
				input_position1 = "@get_entity_info.output_position"
				input_position2 = "@globals.output_listener_position"
			},
			{
				name = "group_priority_limiter"
				execute_once = "true"
				operator = "soundevent_group_join"
				input_group_name = "default_volume_mute_group"
				input_limit_priority = "@distance_to_source.output"
			},
			{
				name = "update_opvar"
				execute_once = "false"
				operator = "soundevent_group_opvars"
				input_limit_priority = "@distance_to_source.output"
			},
			{
				name = "mult_volume"
				operator = "math_float"
				execute_once = "false"
				apply = "mult"
				input1 = "@public.group_pause"
				input2 = "@public.volume_atten"
			},
			{
				name = "filter_float"
				operator = "math_filter_float"
				input = "@mult_volume.output"
				input_max_velocity = "@public.group_vol_filter_rate"
			},
			{
				name = "citadel_perspective_default"
				operator = "sos_import_stack"
				import_stack = "citadel_perspective_default"
				auto_connect_public_fields = "true"
				operator_variables = 
				{
					volume_atten = 
					{
						data_type = "float"
						value = "@filter_float.output"
					}
				}
			},
		]
		_system_properties = 
		{
			display_game = "citadel"
		}
	}
}
