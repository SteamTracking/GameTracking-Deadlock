{
	citadel_music_postgame = 
	{
		operators = 
		[
			{
				name = "_builtins"
				operator = "sos_builtins"
				_voicegraph = "citadel.2d"
			},
			{
				name = "public"
				operator = "util_null"
				operator_variables = 
				{
					citadel_default_2d = 
					{
						data_type = "public_opvar"
						value = "citadel_default_2d"
					}
					enable_rankup = 
					{
						data_type = "float"
						value = "0.0"
					}
					preload_vsnds = 
					{
						data_type = "float"
						value = "15"
					}
					crossfade_velocity = 
					{
						data_type = "float"
						value = "1"
					}
					vsnd_files_rankup = 
					{
						data_type = "vsnd"
						soundevent_data = "true"
						value = 
						[
							"sounds/music/music_postgame_rankup_155bpm.vsnd",
						]
						_system_properties = 
						{
							property_group = "VSND Files"
						}
					}
				}
			},
			{
				name = "volume_crossfade"
				operator = "math_filter_float"
				input = "@public.enable_rankup"
				input_max_velocity = "@public.crossfade_velocity"
			},
			{
				name = "math_crossfade_inverse"
				operator = "math_float"
				apply = "sub"
				input1 = "1.0"
				input2 = "@volume_crossfade.output"
			},
			{
				name = "math_volume_ranked"
				input_execute = "1.0"
				operator = "math_gain_to_db"
				input = "@volume_crossfade.output"
			},
			{
				name = "math_volume_mvp"
				input_execute = "1.0"
				operator = "math_gain_to_db"
				input = "@math_crossfade_inverse.output"
			},
			{
				name = "citadel_default_2d"
				operator = "sos_import_stack"
				import_stack = "citadel_default_2d"
				auto_connect_public_fields = "true"
				operator_variables = 
				{
					track_1.vsnd_track_vol_offset_db = 
					{
						data_type = "float"
						value = "@math_volume_mvp.output"
					}
					track_2.vsnd_files_field_name = 
					{
						data_type = "string"
						value = "vsnd_files_rankup"
					}
					track_2.vsnd_track_vol_offset_db = 
					{
						data_type = "float"
						value = "@math_volume_ranked.output"
					}
				}
			},
		]
		_system_properties = 
		{
			display_game = "citadel"
		}
	}
}
