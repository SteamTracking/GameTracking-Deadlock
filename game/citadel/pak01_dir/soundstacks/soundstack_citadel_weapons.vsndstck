			{
				name = "globals"
				operator = "get_system_globals"
				input_execute = "1.0"
				input_listener_index = "0"
			},
			{
				name = "voicegraph_send"
				input_execute = "1.0"
				operator = "vmix_voicegraph_input"
				input_name = "clip_fraction"
				input = "@public.clip_fraction"
			},
			{
				name = "remap_fire_rate_percent"
				operator = "math_curve_2d"
				input = "@public.fire_rate_percent"
				public_field_name = "public.fire_rate_percent_curve_db_offset"
			},
			{
				name = "remap_continuous_fire_time"
				operator = "math_curve_2d"
				input = "@public.continuous_fire_elapsed_time"
				public_field_name = "public.continuous_fire_time_curve_db_offset"
			},
			{
				name = "volume_accumulate"
				operator = "math_accumulate12_float"
				apply = "add"
				input1 = "@public.volume"
				input2 = "@remap_fire_rate_percent.output"
				input3 = "@remap_continuous_fire_time.output"
				input4 = "0.0"
				input5 = "0.0"
				input6 = "0.0"
				input7 = "0.0"
				input8 = "0.0"
				input9 = "0.0"
				input10 = "0.0"
				input11 = "0.0"
				input12 = "0.0"
			},
			{
				name = "math_clip_amount_min"
				operator = "math_float"
				execute_once = "1.0"
				apply = "min"
				input1 = "@public.clip_amount"
				input2 = "@public.low_ammo_threshold"
			},
			{
				name = "math_low_ammo_progress"
				operator = "math_float"
				execute_once = "1.0"
				apply = "div"
				input1 = "@math_clip_amount_min.output"
				input2 = "@public.low_ammo_threshold"
			},
			{
				name = "math_invert_low_ammo_progress"
				operator = "math_float"
				execute_once = "1.0"
				apply = "sub"
				input1 = "1.0"
				input2 = "@math_low_ammo_progress.output"
			},
			{
				name = "math_invert_is_sliding"
				operator = "math_float"
				execute_once = "1.0"
				apply = "sub"
				input1 = "1.0"
				input2 = "@public.is_sliding"
			},
			{
				name = "math_disable_low_ammo_for_sliding"
				operator = "math_float"
				execute_once = "1.0"
				apply = "mult"
				input1 = "@math_invert_low_ammo_progress.output"
				input2 = "@math_invert_is_sliding.output"
			},
			{
				name = "remap_low_ammo_offset"
				operator = "math_curve_2d"
				execute_once = "1.0"
				input = "@math_disable_low_ammo_for_sliding.output"
				public_field_name = "public.low_ammo_progress_offset_db"
			},
			{
				name = "math_low_ammo_volume"
				operator = "math_float"
				execute_once = "1.0"
				apply = "add"
				input1 = "@remap_low_ammo_offset.output"
				input2 = "@public.low_ammo_vol_offset_db"
			},
			{
				name = "math_play_last_shot"
				operator = "math_float"
				execute_once = "1.0"
				apply = "less_than_or_equal"
				input1 = "@public.clip_amount"
				input2 = "@public.last_shot_clip_value"
			},
			{
				name = "math_disable_last_shot_for_sliding"
				operator = "math_float"
				execute_once = "1.0"
				apply = "mult"
				input1 = "@math_invert_is_sliding.output"
				input2 = "@math_play_last_shot.output"
			},
			{
				name = "math_enable_last_shot"
				operator = "math_float"
				execute_once = "1.0"
				apply = "mult"
				input1 = "@math_disable_last_shot_for_sliding.output"
				input2 = "@public.last_shot_enabled"
			},
			{
				name = "citadel_find_perspective"
				operator = "sos_import_stack"
				import_stack = "citadel_find_perspective"
				auto_connect_public_fields = "true"
			},
			{
				name = "switch_fade_out_time"
				operator = "ctrl_switch_float"
				input_switch = "@citadel_find_perspective::output.perspective_is_player"
				input1 = ".03"
				input2 = "@public.volume_fade_out"
			},
			{
				name = "volume_interior_tail_public_offset_to_gain"
				operator = "math_db_to_gain"
				input = "@public.tail_interior_vol_offset_db"
			},
			{
				name = "source_info"
				operator = "game_get_source_info"
				execute_once = "1.0"
			},
			{
				name = "print_dimension_tails"
				operator = "util_print_string"
				execute_once = "1.0"
				input_execute = "0.0"
				input = "USING DIMENSION PROBE WEAPON TAILS"
			},
			{
				name = "get_entity_info"
				operator = "game_entity_info"
				input_default_world_position = "@public.position"
				input_default_local_position = "@globals.output_listener_front"
				input_hold_position_on_deleted_entity = "true"
				use_world_position = "@public.position_force_from_input"
				attachment = "@public.attachment"
			},
			{
				name = "add_position_offset"
				operator = "math_float3"
				apply = "add"
				input1 = "@get_entity_info.output_position"
				input2 = "@public.position_offset"
			},
			{
				name = "import_steamaudio_dimension_probes"
				operator = "sos_import_stack"
				import_stack = "citadel_steamaudio_dimension_probes"
				operator_variables = 
				{
					input_steamaudio_dimension_probes_entity_index = 
					{
						data_type = "float"
						value = "@source_info.output_entity_index"
					}
				}
			},
			{
				name = "normalize_room_size_to_enclosure"
				operator = "math_float"
				execute_once = "1.0"
				apply = "div"
				input1 = "@import_steamaudio_dimension_probes::output.dimension_size"
				input2 = "2500"
			},
			{
				name = "remap_enclosure_tail_volume_offset_probe"
				operator = "math_curve_2d"
				execute_once = "1.0"
				input = "@normalize_room_size_to_enclosure.output"
				public_field_name = "public.tail_enclosure_vol_offset_db"
			},
			{
				name = "math_add_tail_volume_probe"
				operator = "math_float"
				execute_once = "1.0"
				apply = "add"
				input1 = "@remap_enclosure_tail_volume_offset_probe.output"
				input2 = "@public.tail_vol_offset_db"
			},
			{
				name = "math_floor_tail_exterior_volume_probe"
				operator = "math_float"
				execute_once = "1.0"
				apply = "max"
				input1 = "@public.tail_exterior_sky_exposure_floor_db"
				input2 = "@math_add_tail_volume_probe.output"
			},
			{
				name = "math_inout_probe_is_outside"
				operator = "math_float"
				execute_once = "1.0"
				apply = "greater_than_or_equal"
				input1 = "@import_steamaudio_dimension_probes::output.dimension_inout"
				input2 = "0.02"
			},
			{
				name = "ctrl_switch_tail_min_volume_probe"
				operator = "ctrl_switch_float"
				execute_once = "1.0"
				input_switch = "@math_inout_probe_is_outside.output"
				input1 = "@math_add_tail_volume_probe.output"
				input2 = "@math_floor_tail_exterior_volume_probe.output"
			},
			{
				name = "volume_exterior_remap_db_to_gain_probe"
				operator = "math_db_to_gain"
				execute_once = "1.0"
				input = "@remap_enclosure_tail_volume_offset_probe.output"
			},
			{
				name = "math_crossfade_interior_tail_vol_probe"
				operator = "math_float"
				execute_once = "1.0"
				apply = "sub"
				input1 = "1.0"
				input2 = "@volume_exterior_remap_db_to_gain_probe.output"
			},
			{
				name = "math_mult_interior_tail_probe"
				operator = "math_float"
				execute_once = "1.0"
				apply = "mult"
				input1 = "@math_crossfade_interior_tail_vol_probe.output"
				input2 = "@volume_interior_tail_public_offset_to_gain.output"
			},
			{
				name = "volume_interior_tail_crossfade_probe"
				operator = "math_gain_to_db"
				execute_once = "1.0"
				input = "@math_mult_interior_tail_probe.output"
			},
			{
				name = "remap_tail_interior_volume_offset_probe"
				operator = "math_curve_2d"
				execute_once = "1.0"
				input = "@normalize_room_size_to_enclosure.output"
				public_field_name = "public.tail_interior_enclosure_vol_offset_db"
			},
			{
				name = "math_tail_interior_volume_probe"
				operator = "math_float"
				execute_once = "1.0"
				apply = "add"
				input1 = "@volume_interior_tail_crossfade_probe.output"
				input2 = "@remap_tail_interior_volume_offset_probe.output"
			},
			{
				name = "citadel_perspective_default"
				operator = "sos_import_stack"
				import_stack = "citadel_perspective_default"
				auto_connect_public_fields = "true"
				operator_variables = 
				{
					volume = 
					{
						data_type = "float"
						value = "@volume_accumulate.output"
					}
					volume_fade_out = 
					{
						data_type = "float"
						value = "@switch_fade_out_time.output"
					}
					track_1.volume_fade_in_track = 
					{
						data_type = "float"
						value = "@public.volume_fade_in_transient"
					}
					track_1.vsnd_track_vol_offset_db = 
					{
						data_type = "float"
						value = "@public.transient_offset_db"
					}
					track_2.vsnd_files_field_name = 
					{
						data_type = "string"
						value = "vsnd_files_low_ammo"
					}
					track_2.vsnd_start_track = 
					{
						data_type = "bool"
						value = "@public.low_ammo_enabled"
					}
					track_2.volume_fade_in_track = 
					{
						data_type = "float"
						value = "@public.volume_fade_in_low_ammo"
					}
					track_2.vsnd_track_vol_offset_db = 
					{
						data_type = "float"
						value = "@math_low_ammo_volume.output"
					}
					track_2.vsnd_files_track_name = 
					{
						data_type = "string"
						value = "low_ammo"
					}
					track_3.vsnd_files_field_name = 
					{
						data_type = "string"
						value = "vsnd_files_tail"
					}
					track_3.volume_fade_in_track = 
					{
						data_type = "float"
						value = "@public.volume_fade_in_tail"
					}
					track_3.vsnd_track_vol_offset_db = 
					{
						data_type = "float"
						value = "@ctrl_switch_tail_min_volume_probe.output"
					}
					track_3.vsnd_files_track_name = 
					{
						data_type = "string"
						value = "tail"
					}
					track_4.vsnd_files_field_name = 
					{
						data_type = "string"
						value = "vsnd_files_tail_interior"
					}
					track_4.volume_fade_in_track = 
					{
						data_type = "float"
						value = "@public.volume_fade_in_tail_interior"
					}
					track_4.vsnd_track_vol_offset_db = 
					{
						data_type = "float"
						value = "@math_tail_interior_volume_probe.output"
					}
					track_4.vsnd_files_track_name = 
